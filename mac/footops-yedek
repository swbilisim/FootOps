#!/bin/bash
# footops-yedek: open FootOps backups on a Mac (panel-tasarim §27.6).
#
# It only ever reads the servers' restic repositories (a read-only key, --no-lock), so
# nothing it does can change or remove a backup. The account, the key and the
# repositories' passwords come from the Mac's Keychain (service "footops-yedek"), never
# from this file, its arguments or its environment:
#
#   r2-hesap        the Cloudflare R2 account ID
#   r2-mac-erisim   the read-only key's Access Key ID
#   r2-mac-gizli    the read-only key's Secret Access Key
#   restic-<code>   a server's repository password (e.g. restic-h1)
#   kova-<code>     optional: the server's bucket (default footops-<code>)
#
# Needs restic (brew install restic); --mongo also needs mongorestore and a running
# MongoDB (brew install mongodb-database-tools mongodb-community@7.0). macOS's own bash
# 3.2, jq and python3 do the rest.
set -euo pipefail

SERVICE=${FOOTOPS_YEDEK_SERVICE:-footops-yedek}
RESTIC=${RESTIC:-restic}
TMPD=""

# PYTIME parses restic's times ("2026-11-07T01:00:05.123456789Z" or with an offset,
# "+03:00"): macOS's python 3.9 takes neither the nanoseconds nor the Z.
PYTIME='
import re
from datetime import datetime, timedelta, timezone
def ts(t):
    m = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d+)?(Z|[+-]\d\d:\d\d)?$", t)
    if not m:
        raise ValueError("zaman anlaşılamadı: " + t)
    off = m.group(2) or "Z"
    tz = timezone.utc if off == "Z" else timezone((1 if off[0] == "+" else -1) * timedelta(hours=int(off[1:3]), minutes=int(off[4:6])))
    return datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=tz)
'


usage() {
	cat <<'EOF'
Kullanım: footops-yedek <komut>

  sunucular                         Anahtar Zinciri'ndeki sunucular ve kovaları
  dene <sunucu>                     depo bu Mac'teki anahtar ve şifreyle açılıyor mu (yalnız okur)
  liste <sunucu> [site]             siteler ve son yedekleri; site verilirse o sitenin yedekleri
  ac <sunucu> <site> [zaman] [--hedef KLASÖR] [--mongo [VERİTABANI]]
                                    sitenin yedeğini klasöre açar (varsayılan ~/Downloads/<site>-<zaman>):
                                    db.archive, files/, env, footops.json, compose.yaml
                                    zaman: "2026-11-07 04:00" — o ana kadarki en yeni yedek (boş: en son)
                                    --mongo: veritabanını Mac'teki MongoDB'ye de yükler
                                    (varsayılan ad <site>_yedek_<tarih>; MONGO_URI ile başka sunucu)
  kurtarma <sunucu>                 "yedekten kur" için tek satırlık kurtarma bilgisi (SIR içerir):
                                    footops-yedek kurtarma h1 | pbcopy

Yedeklere yalnız okuyarak erişir (salt okunur anahtar, kilitsiz): hiçbir yedek değişmez ya da silinmez.
EOF
}

die() {
	printf '✗ %s\n' "$*" >&2
	exit 1
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# kc reads one item from the Keychain.
kc() { security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null; }

need() {
	command -v "$1" >/dev/null 2>&1 || die "$1 bulunamadı: $2"
}

cleanup() {
	if [ -n "$TMPD" ]; then
		rm -rf "$TMPD"
	fi
}
trap cleanup EXIT

# servers lists the server codes that have a repository password in the Keychain
# (the items' names only: dump-keychain prints no secret without -d).
servers() {
	security dump-keychain 2>/dev/null | awk -v svc="\"$SERVICE\"" '
		/^keychain: /         { acct = "" }
		/"acct"<blob>=/       { a = $0; sub(/.*"acct"<blob>="/, "", a); sub(/"$/, "", a); acct = a }
		/"svce"<blob>=/       { s = $0; sub(/.*"svce"<blob>=/, "", s); if (s == svc && acct ~ /^restic-/) print substr(acct, 8) }
	' | sort -u
}

# open_repo readies restic for one server: its repository, the read-only key in a
# private temporary file, the password through the Keychain (restic asks for it).
open_repo() {
	local code
	code=$(lower "$1")
	case "$code" in
	'' | *[!a-z0-9-]*) die "geçersiz sunucu kodu: $1" ;;
	esac
	need "$RESTIC" "brew install restic"
	local account key secret bucket
	account=$(kc r2-hesap) || die "Anahtar Zinciri'nde $SERVICE / r2-hesap yok (R2 hesap kimliği)"
	key=$(kc r2-mac-erisim) || die "Anahtar Zinciri'nde $SERVICE / r2-mac-erisim yok (salt okunur anahtar)"
	secret=$(kc r2-mac-gizli) || die "Anahtar Zinciri'nde $SERVICE / r2-mac-gizli yok (salt okunur anahtar)"
	kc "restic-$code" >/dev/null || die "Anahtar Zinciri'nde $SERVICE / restic-$code yok (bu sunucunun depo şifresi)"
	bucket=$(kc "kova-$code" || true)
	[ -n "$bucket" ] || bucket="footops-$code"
	TMPD=$(mktemp -d "${TMPDIR:-/tmp}/footops-yedek.XXXXXX")
	chmod 700 "$TMPD"
	(
		umask 077
		printf '[default]\naws_access_key_id = %s\naws_secret_access_key = %s\n' "$key" "$secret" >"$TMPD/s3"
	)
	export AWS_SHARED_CREDENTIALS_FILE="$TMPD/s3"
	export RESTIC_REPOSITORY="s3:https://$account.r2.cloudflarestorage.com/$bucket"
	export RESTIC_PASSWORD_COMMAND="security find-generic-password -s $SERVICE -a restic-$code -w"
	export RESTIC_CACHE_DIR="$HOME/Library/Caches/footops-yedek/restic"
	export RESTIC_PROGRESS_FPS=0.5
	unset RESTIC_PASSWORD RESTIC_PASSWORD_FILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
	BUCKET=$bucket
}

r() { "$RESTIC" --no-lock "$@"; }

# snapshots prints FootOps' snapshots (of one site, if given) as JSON.
snapshots() {
	if [ -n "${1:-}" ]; then
		r snapshots --json --tag "footops,site=$1"
	else
		r snapshots --json --tag footops
	fi
}

cmd_servers() {
	local list
	list=$(servers)
	[ -n "$list" ] || die "Anahtar Zinciri'nde $SERVICE / restic-<sunucu> kaydı yok"
	printf '%-8s %s\n' "SUNUCU" "KOVA"
	local c b
	for c in $list; do
		b=$(kc "kova-$c" || true)
		printf '%-8s %s\n' "$c" "${b:-footops-$c}"
	done
}

# cmd_check opens a server's repository the way a recovery does (its config, no lock)
# and reads its newest snapshot.
cmd_check() {
	[ $# -eq 1 ] || die "kullanım: footops-yedek dene <sunucu>"
	open_repo "$1"
	r cat config >/dev/null 2>&1 || die "depo açılmadı ($BUCKET): anahtar, kova ya da şifre yanlış olabilir"
	local n
	n=$(snapshots | python3 -c 'import json,sys; print(len(json.load(sys.stdin) or []))')
	printf '✓ %s açıldı (salt okunur): %s anlık görüntü\n' "$BUCKET" "$n"
}

cmd_list() {
	[ $# -ge 1 ] || die "kullanım: footops-yedek liste <sunucu> [site]"
	open_repo "$1"
	local site=${2:-}
	snapshots "$site" | python3 -c "$PYTIME"'
import json, sys
site = sys.argv[1]
snaps = json.load(sys.stdin) or []
def tags(s):
    out = {}
    for t in s.get("tags") or []:
        k, _, v = t.partition("=")
        out[k] = v
    return out
def local(t):
    return ts(t).astimezone().strftime("%d.%m.%Y %H:%M")
def size(n):
    for u in ["B", "KB", "MB", "GB"]:
        if n < 1024 or u == "GB":
            return ("%d %s" % (n, u)) if u == "B" else ("%.1f %s" % (n, u))
        n /= 1024
kinds = {"daily": "gece", "hourly": "saatlik", "manual": "elle"}
if not site:
    last = {}
    for s in snaps:
        t = tags(s)
        key = (t.get("site", "?"), t.get("part", "?"))
        if key not in last or ts(s["time"]) > ts(last[key]["time"]):
            last[key] = s
    names = sorted({k[0] for k in last})
    print("%-22s %-17s %-17s %-17s" % ("SİTE", "VERİTABANI", "DOSYALAR", "TANIM"))
    for n in names:
        cell = lambda p: local(last[(n, p)]["time"]) if (n, p) in last else "—"
        if n == "_server":
            continue
        print("%-22s %-17s %-17s %-17s" % (n, cell("db"), cell("files"), cell("def")))
    if ("_server", "server") in last:
        print("\nsunucu ayarları: " + local(last[("_server", "server")]["time"]))
    sys.exit(0)
runs = {}
for s in snaps:
    t = tags(s)
    run = t.get("run") or s["id"]
    r = runs.setdefault(run, {"time": s["time"], "kind": t.get("kind", ""), "parts": {}})
    r["time"] = min(r["time"], s["time"], key=ts)
    summ = s.get("summary") or {}
    r["parts"][t.get("part", "?")] = summ
if not runs:
    sys.exit("✗ bu sitenin yedeği yok: " + site)
print("%-17s %-8s %s" % ("ZAMAN", "TÜR", "PARÇALAR"))
for run, r in sorted(runs.items(), key=lambda x: ts(x[1]["time"]), reverse=True)[:40]:
    parts = []
    for p, label in [("db", "veritabanı"), ("files", "dosyalar"), ("def", "tanım")]:
        if p in r["parts"]:
            sm = r["parts"][p]
            if p == "files":
                parts.append("%s (%d dosya, %s)" % (label, sm.get("total_files_processed", 0), size(sm.get("total_bytes_processed", 0))))
            elif p == "db":
                parts.append("%s (%s)" % (label, size(sm.get("total_bytes_processed", 0))))
            else:
                parts.append(label)
    print("%-17s %-8s %s" % (local(r["time"]), kinds.get(r["kind"], r["kind"]), ", ".join(parts)))
' "$site"
}

# pick prints the IDs of the newest db, files and def snapshots of a site at or before
# "at" (UTC, "YYYY-MM-DDTHH:MM:SS"; empty: the newest), with each one's time in UTC,
# one per line: "<part> <id> <time>".
pick() {
	python3 -c "$PYTIME"'
import json, sys
at = datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc) if sys.argv[1] else None
best = {}
for s in json.load(sys.stdin) or []:
    tags = dict(t.partition("=")[::2] for t in s.get("tags") or [])
    part = tags.get("part")
    if part not in ("db", "files", "def") or (at and ts(s["time"]) > at):
        continue
    if part not in best or ts(s["time"]) > ts(best[part]["time"]):
        best[part] = s
for p, s in sorted(best.items()):
    print(p, s["id"], ts(s["time"]).astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S"))
' "$1"
}

cmd_open() {
	[ $# -ge 2 ] || die "kullanım: footops-yedek ac <sunucu> <site> [zaman] [--hedef KLASÖR] [--mongo [VERİTABANI]]"
	local server=$1 site=$2 at="" target="" mongo="" mongodb=""
	shift 2
	while [ $# -gt 0 ]; do
		case "$1" in
		--hedef)
			[ $# -ge 2 ] || die "--hedef bir klasör ister"
			target=$2
			shift 2
			;;
		--mongo)
			mongo=1
			if [ $# -ge 2 ] && [ "${2#--}" = "$2" ]; then
				mongodb=$2
				shift
			fi
			shift
			;;
		--*) die "bilinmeyen seçenek: $1" ;;
		*)
			[ -z "$at" ] || die "fazla bağımsız değişken: $1"
			at=$1
			shift
			;;
		esac
	done
	case "$site" in
	'' | *[!a-z0-9-]*) die "geçersiz site adı: $site" ;;
	esac
	local atutc=""
	if [ -n "$at" ]; then
		atutc=$(python3 -c '
import sys
from datetime import datetime
try:
    t = datetime.strptime(sys.argv[1], "%Y-%m-%d %H:%M").astimezone()
except ValueError:
    sys.exit(1)
print(t.astimezone(__import__("datetime").timezone.utc).strftime("%Y-%m-%dT%H:%M:%S"))
' "$at") || die "zaman YYYY-AA-GG SS:DD biçiminde olmalı, örnek: 2026-11-07 04:00"
	fi
	if [ -n "$mongo" ]; then
		need mongorestore "brew install mongodb-database-tools"
	fi
	open_repo "$server"
	local chosen
	chosen=$(snapshots "$site" | pick "$atutc")
	[ -n "$chosen" ] || die "bu sitenin $( [ -n "$at" ] && printf '%s öncesinde ' "$at")yedeği yok: $site"
	local db="" files="" def="" newest=""
	local part id time
	while read -r part id time; do
		case "$part" in
		db) db=$id ;;
		files) files=$id ;;
		def) def=$id ;;
		esac
		if [ -z "$newest" ] || [[ "$time" > "$newest" ]]; then
			newest=$time
		fi
	done <<<"$chosen"
	local stamp
	stamp=$(python3 -c '
import sys
from datetime import datetime, timezone
print(datetime.strptime(sys.argv[1], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).astimezone().strftime("%Y%m%d-%H%M"))
' "$newest")
	[ -n "$target" ] || target="$HOME/Downloads/$site-$stamp"
	if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
		die "$target dolu: başka bir --hedef ver ya da klasörü sil"
	fi
	mkdir -p "$target"
	chmod 700 "$target"
	printf 'Açılıyor: %s / %s → %s\n' "$BUCKET" "$site" "$target"
	if [ -n "$db" ]; then
		printf '  … veritabanı\n'
		r dump "$db" "/footops/$site/db.archive" >"$target/db.archive"
		chmod 600 "$target/db.archive"
		printf '  ✓ db.archive (%s bayt)\n' "$(wc -c <"$target/db.archive" | tr -d ' ')"
	fi
	if [ -n "$files" ]; then
		printf '  … dosyalar\n'
		r restore "$files:/footops/$site/files" --target "$target/files"
		printf '  ✓ files/ (%s dosya)\n' "$(find "$target/files" -type f | wc -l | tr -d ' ')"
	fi
	if [ -n "$def" ]; then
		(
			umask 077
			r dump "$def" "/footops/$site/def/footops.json" >"$target/footops.json"
			r dump "$def" "/footops/$site/def/compose.yaml" >"$target/compose.yaml"
			# The environment as the panel's download writes it: sorted, double-quoted,
			# \n \r \t \" \\ escaped; the site's FootOps database connection left out (it
			# opens nothing anywhere else).
			python3 -c '
import json, sys
meta = json.load(open(sys.argv[1]))
dbvar = (meta.get("db_var") or "MONGODB_URI") if meta.get("database") else None
env, inside = {}, False
for line in open(sys.argv[2], encoding="utf-8").read().split("\n"):
    if line == "    environment:":
        inside = True
        continue
    if not inside:
        continue
    if not line.startswith("      "):
        break
    k, _, v = line[6:].partition(": ")
    env[k] = json.loads(v).replace("$$", "$")
out = ["# SIRLAR İÇERİR: " + meta.get("name", "") + " sitesinin ortam değişkenleri (FootOps yedeği)"]
if dbvar and dbvar in env:
    del env[dbvar]
    out.append("# " + dbvar + " alınmadı: sunucunun kendi veritabanı bağlantısı, başka yerde bir şey açmaz")
def q(v):
    return v.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
for k in sorted(env):
    out.append("%s=\"%s\"" % (k, q(env[k])))
open(sys.argv[3], "w", encoding="utf-8").write("\n".join(out) + "\n")
' "$target/footops.json" "$target/compose.yaml" "$target/env"
		)
		printf '  ✓ footops.json, compose.yaml, env (sırlar içerir; klasör yalnız senin)\n'
	fi
	if [ -n "$mongo" ]; then
		[ -n "$db" ] || die "bu yedekte veritabanı yok"
		local from
		from=$(python3 -c '
import json, sys
print(json.load(open(sys.argv[1])).get("name", ""))' "$target/footops.json" 2>/dev/null || true)
		[ -n "$from" ] || from=$site
		[ -n "$mongodb" ] || mongodb="${site//-/_}_yedek_${stamp%%-*}"
		case "$mongodb" in
		'' | *[!A-Za-z0-9_-]*) die "geçersiz veritabanı adı: $mongodb" ;;
		esac
		printf '  … Mac MongoDB: %s → %s (%s)\n' "$from" "$mongodb" "${MONGO_URI:-mongodb://127.0.0.1:27017}"
		if ! mongorestore --uri="${MONGO_URI:-mongodb://127.0.0.1:27017}" --archive="$target/db.archive" \
			--nsInclude="$from.*" --nsFrom="$from.*" --nsTo="$mongodb.*" --drop --quiet; then
			die "mongorestore başarısız (MongoDB çalışıyor mu? brew services start mongodb-community@7.0)"
		fi
		printf '  ✓ yüklendi: %s (aynı adlı koleksiyonlar silinip yeniden yüklendi)\n' "$mongodb"
	fi
	printf '✓ Bitti: %s\n' "$target"
}

cmd_recovery() {
	[ $# -eq 1 ] || [ $# -eq 2 ] || die "kullanım: footops-yedek kurtarma <sunucu> | pbcopy"
	if [ -t 1 ] && [ "${2:-}" != "--goster" ]; then
		die "bu satır sır içerir; ekrana yazılmaz. Panoya al: footops-yedek kurtarma $1 | pbcopy"
	fi
	local code account key secret bucket
	code=$(lower "$1")
	case "$code" in
	'' | *[!a-z0-9-]*) die "geçersiz sunucu kodu: $1" ;;
	esac
	# Sent to a file instead of a pipe, it is the owner's only.
	umask 077
	account=$(kc r2-hesap) || die "Anahtar Zinciri'nde $SERVICE / r2-hesap yok"
	key=$(kc r2-mac-erisim) || die "Anahtar Zinciri'nde $SERVICE / r2-mac-erisim yok"
	secret=$(kc r2-mac-gizli) || die "Anahtar Zinciri'nde $SERVICE / r2-mac-gizli yok"
	kc "restic-$code" >/dev/null || die "Anahtar Zinciri'nde $SERVICE / restic-$code yok"
	bucket=$(kc "kova-$code" || true)
	[ -n "$bucket" ] || bucket="footops-$code"
	# The values reach python on stdin, not on its command line.
	printf '%s\n%s\n%s\n%s\n' "s3:https://$account.r2.cloudflarestorage.com/$bucket" "$key" "$secret" "$(kc "restic-$code")" |
		python3 -c '
import base64, json, sys
repo, key, secret, pw = sys.stdin.read().split("\n")[:4]
info = {"repository": repo, "key_id": key, "secret_key": secret, "password": pw}
print("FOOTOPS-KURTARMA-1:" + base64.b64encode(json.dumps(info, separators=(",", ":")).encode()).decode())'
	printf 'Kurtarma bilgisi yazıldı (%s, salt okunur anahtar). Sunucuda "Kurtarma bilgisi" sorusuna yapıştır;\npanoya aldıysan sonra temizle: pbcopy </dev/null\n' "$bucket" >&2
}

case "${1:-}" in
sunucular) shift; cmd_servers "$@" ;;
dene) shift; cmd_check "$@" ;;
liste) shift; cmd_list "$@" ;;
ac) shift; cmd_open "$@" ;;
kurtarma) shift; cmd_recovery "$@" ;;
'' | -h | --help | yardim | yardım) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
